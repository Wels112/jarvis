# Ключи Джарвиса. Скопируй этот файл в config/.env и впиши свои.
# Этот файл — образец, он в репозитории; config/.env в репозиторий не попадает.

# Мозг и живой разговор. Бесплатно: aistudio.google.com/apikey
GEMINI_API_KEY=

# Связь с телефоном. Бот создаётся за минуту у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Поиск видео по названию. Без него открывается страница поиска YouTube
YOUTUBE_API_KEY=

# Свой канал, чтобы спрашивать статистику голосом
YOUTUBE_CHANNEL=

# Чтение своих чатов от своего имени: my.telegram.org, API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
